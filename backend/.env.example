# Copy to backend/.env for local runs (npm run dev). Never commit the real .env.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=chitti
FIREBASE_PROJECT_ID=chitti-bd8ce
# base64 of the Firebase service-account JSON. Required when NODE_ENV=production.
# Without it (dev only) tokens are still verified, but revocation is not checked.
FIREBASE_SERVICE_ACCOUNT_BASE64=
PORT=8080
MAX_BACKUP_BYTES=52428800
# LOG_LEVEL=info
