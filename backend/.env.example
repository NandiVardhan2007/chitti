# Copy to backend/.env for local runs (npm run dev). Never commit the real .env.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=chitti
FIREBASE_PROJECT_ID=chitti-919e7
# Optional: base64 of the Firebase service-account JSON (must be for FIREBASE_PROJECT_ID).
# Without it tokens are still fully verified; only the revocation check is skipped.
FIREBASE_SERVICE_ACCOUNT_BASE64=
PORT=8080
MAX_BACKUP_BYTES=52428800
# LOG_LEVEL=info
